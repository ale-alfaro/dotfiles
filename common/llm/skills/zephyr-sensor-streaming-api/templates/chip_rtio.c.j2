#define DT_DRV_COMPAT {{ compat_under }}

#include <zephyr/drivers/sensor.h>
#include <zephyr/drivers/sensor_clock.h>
#include <zephyr/rtio/rtio.h>
#include <zephyr/rtio/work.h>
#include <zephyr/logging/log.h>

#include "{{ chip }}.h"

LOG_MODULE_DECLARE({{ chip }}, CONFIG_SENSOR_LOG_LEVEL);

/*
 * One-shot path: a blocking work-req that fills a {{ chip }}_sample buffer.
 * Runs in workqueue context, so blocking bus reads are allowed here.
 */
static void {{ chip }}_oneshot_blocking(struct rtio_iodev_sqe *iodev_sqe)
{
	const struct sensor_read_config *cfg =
		(const struct sensor_read_config *)iodev_sqe->sqe.iodev->data;
	const struct device *dev = cfg->sensor;
	struct {{ chip }}_data *data = dev->data;
	uint8_t *buf;
	uint32_t buf_len;
	uint64_t cycles;
	int rc;

	const uint32_t min_buf_len = sizeof(struct {{ chip }}_sample);

	rc = rtio_sqe_rx_buf(iodev_sqe, min_buf_len, min_buf_len, &buf, &buf_len);
	if (rc != 0) {
		LOG_ERR("Failed to acquire one-shot RX buffer: %d", rc);
		rtio_iodev_sqe_err(iodev_sqe, rc);
		return;
	}

	struct {{ chip }}_sample *sample = (struct {{ chip }}_sample *)buf;

	memset(sample, 0, sizeof(*sample));

	rc = sensor_clock_get_cycles(&cycles);
	if (rc != 0) {
		LOG_ERR("Failed to read sensor clock: %d", rc);
		rtio_iodev_sqe_err(iodev_sqe, rc);
		return;
	}

	sample->header.timestamp = sensor_clock_cycles_to_ns(cycles);
	sample->header.is_fifo   = 0;
	/* TODO: encode current range/odr into the header from data->... */
	ARG_UNUSED(data);

	/*
	 * TODO: blocking bus read of the chip's data registers into
	 * sample->payload (length {{ chip_upper }}_SAMPLE_SIZE). Use bus
	 * helpers from {{ chip }}.c, not the RTIO context here.
	 */

	rtio_iodev_sqe_ok(iodev_sqe, 0);
}

void {{ chip }}_submit(const struct device *dev, struct rtio_iodev_sqe *iodev_sqe)
{
	const struct sensor_read_config *cfg =
		(const struct sensor_read_config *)iodev_sqe->sqe.iodev->data;

	if (!cfg->is_streaming) {
		struct rtio_work_req *req = rtio_work_req_alloc();

		if (req == NULL) {
			LOG_ERR("rtio_work_req pool exhausted");
			rtio_iodev_sqe_err(iodev_sqe, -ENOMEM);
			return;
		}
		rtio_work_req_submit(req, iodev_sqe, {{ chip }}_oneshot_blocking);
{% if streaming %}
	} else if (IS_ENABLED(CONFIG_{{ chip_upper }}_STREAM)) {
		{{ chip }}_submit_stream(dev, iodev_sqe);
{% endif %}
	} else {
		rtio_iodev_sqe_err(iodev_sqe, -ENOTSUP);
	}
}
