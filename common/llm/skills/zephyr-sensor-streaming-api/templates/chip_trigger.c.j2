#include <zephyr/drivers/gpio.h>
#include <zephyr/drivers/sensor.h>
#include <zephyr/logging/log.h>

#include "{{ chip }}.h"

LOG_MODULE_DECLARE({{ chip }}, CONFIG_SENSOR_LOG_LEVEL);

static void {{ chip }}_gpio_callback(const struct device *port,
				     struct gpio_callback *cb, uint32_t pins)
{
	struct {{ chip }}_data *data = CONTAINER_OF(cb, struct {{ chip }}_data, gpio_cb);
	const struct device *dev = data->dev;
	const struct {{ chip }}_config *cfg = dev->config;

	ARG_UNUSED(port);
	ARG_UNUSED(pins);

	/* Mask further IRQs while we service this one. */
	gpio_pin_interrupt_configure_dt(&cfg->int_gpios, GPIO_INT_DISABLE);

#ifdef CONFIG_{{ chip_upper }}_STREAM
	if (data->streaming_sqe != NULL) {
		/* Streaming has exclusive ownership of the IRQ while active. */
		{{ chip }}_stream_irq_handler(dev);
		return;
	}
#endif

	/*
	 * TODO: route to the legacy DRDY handler set via sensor_trigger_set,
	 * or simply re-arm the IRQ if no legacy consumer is wired up.
	 */
	gpio_pin_interrupt_configure_dt(&cfg->int_gpios, GPIO_INT_EDGE_TO_ACTIVE);
}

int {{ chip }}_init_interrupt(const struct device *dev)
{
	const struct {{ chip }}_config *cfg = dev->config;
	struct {{ chip }}_data *data = dev->data;
	int rc;

	if (!gpio_is_ready_dt(&cfg->int_gpios)) {
		LOG_ERR("Interrupt GPIO not ready");
		return -ENODEV;
	}

	rc = gpio_pin_configure_dt(&cfg->int_gpios, GPIO_INPUT);
	if (rc < 0) {
		return rc;
	}

	gpio_init_callback(&data->gpio_cb, {{ chip }}_gpio_callback,
			   BIT(cfg->int_gpios.pin));

	rc = gpio_add_callback(cfg->int_gpios.port, &data->gpio_cb);
	if (rc < 0) {
		return rc;
	}

	return gpio_pin_interrupt_configure_dt(&cfg->int_gpios,
					       GPIO_INT_EDGE_TO_ACTIVE);
}
