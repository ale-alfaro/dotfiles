#endif
};

#define {{ chip_upper }}_RTIO_DEFINE(inst)                                       \
	{{ bus_iodev_macro }}({{ chip }}_bus_iodev_##inst, DT_DRV_INST(inst));   \
	RTIO_DEFINE({{ chip }}_rtio_ctx_##inst, 8, 8)

#define {{ chip_upper }}_DEFINE(inst)                                            \
	{{ chip_upper }}_RTIO_DEFINE(inst);                                      \
	static struct {{ chip }}_data {{ chip }}_data_##inst = {                 \
		.rtio_ctx  = &{{ chip }}_rtio_ctx_##inst,                        \
		.bus_iodev = &{{ chip }}_bus_iodev_##inst,                       \
	};                                                                       \
	static const struct {{ chip }}_config {{ chip }}_config_##inst = {       \
		.bus = {{ bus_spec_get }}(inst),                                 \
{% if streaming %}
		IF_ENABLED(CONFIG_{{ chip_upper }}_STREAM, (                     \
		.int_gpios = GPIO_DT_SPEC_INST_GET_OR(inst, int_gpios, {0}),))   \
{% endif %}
	};                                                                       \
	DEVICE_DT_INST_DEFINE(inst, {{ chip }}_init, NULL,                       \
			      &{{ chip }}_data_##inst,                           \
			      &{{ chip }}_config_##inst,                         \
			      POST_KERNEL, CONFIG_SENSOR_INIT_PRIORITY,          \
			      &{{ chip }}_driver_api);

DT_INST_FOREACH_STATUS_OKAY({{ chip_upper }}_DEFINE)
