static int {{ chip }}_init(const struct device *dev)
{
	const struct {{ chip }}_config *cfg = dev->config;
	struct {{ chip }}_data *data = dev->data;

	data->dev = dev;

	if (!{{ bus_ready_check }}(&cfg->bus)) {
		LOG_ERR("{{ bus_upper }} bus %s not ready", cfg->bus.bus->name);
		return -ENODEV;
	}
	/* TODO: probe chip ID, soft-reset, apply default ODR/range. */

{% if streaming %}
#ifdef CONFIG_{{ chip_upper }}_STREAM
	int ret = {{ chip }}_init_interrupt(dev);

	if (ret < 0) {
		LOG_ERR("Failed to init {{ chip }} interrupt: %d", ret);
		return ret;
	}
#endif /* CONFIG_{{ chip_upper }}_STREAM */
{% endif %}

	return 0;
}

static DEVICE_API(sensor, {{ chip }}_driver_api) = {
