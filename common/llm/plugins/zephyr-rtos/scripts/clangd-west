#!/bin/sh
# Run clangd from the west workspace top (the directory holding .west/),
# using the compile_commands.json symlinked there.
topdir="$(mise x -- west topdir)"
if [ -d "$topdir/.west" ]; then
        exec clangd "$@"
else
        dir=${CLAUDE_PROJECT_DIR:-$PWD}
        while [ "$dir" != / ] && [ ! -d "$dir/.west" ]; do
                dir=$(dirname "$dir")
        done
        cd "$dir" && exec clangd --compile-commands-dir="$dir" "$@"
fi
