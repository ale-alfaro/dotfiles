# Non-sensitive model + runtime config for the llama.cpp container.
# Loaded by mise (`_.file` in mise.toml) into the task shell, then read by
# docker compose for both ${HF_REPO} interpolation and bare LLAMA_ARG_*
# passthroughs. Safe to commit — keep secrets in .env instead.

HF_REPO=unsloth/Qwen3.6-27B-GGUF:UD-Q4_K_XL

# Runtime knobs (LLAMA_ARG_* maps to --flag in llama-server)
LLAMA_ARG_CTX_SIZE=32768
LLAMA_ARG_N_GPU_LAYERS=99
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_JINJA=true

# Chain-of-thought OFF — Web Clipper / summarisation workflows don't benefit
# from it and the latency tax is real. Override per-request with
# {"reasoning": "on"} in the JSON body if a specific call wants thinking.
LLAMA_ARG_REASONING=off
