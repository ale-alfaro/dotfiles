
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# Font
# font-family = "JetBrainsMono Nerd Font"
# font-family = "CaskaydiaMono Nerd Font"
# font-style = Regular
# font-size = 12

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=true
# resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = true

# env = ZDOTDIR="/home/alealfaro/.config/zsh"
command= "zsh -l"
initial-command= "zsh -l"

selection-clear-on-copy = true
copy-on-select = true
quick-terminal-size = 30%
# Slowdown mouse scrolling
# mouse-scroll-multiplier = 2.0
# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env
# Keyboard bindings
keybind=clear
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down

keybind = alt+shift+n=new_tab
keybind = super+alt+n=new_window

keybind = alt+shift+p=toggle_command_palette
keybind = alt+shift+t=toggle_quick_terminal
keybind = global:alt+backquote=toggle_quick_terminal
keybind = alt+shift+i=inspector:toggle
keybind = alt+shift+arrow_up=jump_to_prompt:-1
keybind = alt+shift+arrow_down=jump_to_prompt:1

keybind = alt+shift+g=scroll_to_bottom
keybind = alt+g=scroll_to_top
keybind = shift+page_down=scroll_page_down
keybind = shift+page_up=scroll_page_up


# This are the arrow keys in Colmark DH layout
keybind = ctrl+arrow_up=goto_split:up
keybind = ctrl+arrow_right=goto_split:right
keybind = ctrl+arrow_left=goto_split:left
keybind = ctrl+arrow_down=goto_split:down

keybind = alt+arrow_right=goto_split:next
keybind = alt+arrow_left=goto_split:previous

keybind = alt+shift+arrow_left=previous_tab
keybind = alt+shift+arrow_right=next_tab

keybind = alt+shift+a=select_all

keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = paste=paste_from_clipboard
keybind = ctrl+shift+j=write_screen_file:paste
keybind = shift+insert=paste_from_clipboard
keybind = copy=copy_to_clipboard

keybind = alt+w=close_surface
keybind = alt+shift+w=close_tab
keybind = ctrl+shift+w=close_tab:this
keybind = alt+shift+q=quit

keybind = ctrl+,=open_config
keybind = ctrl+shift+,=reload_config

keybind = ctrl+0=reset_font_size
keybind = alt+shift+enter=toggle_split_zoom
keybind = alt+equal=increase_font_size:1
keybind = alt++=increase_font_size:1
keybind = alt+enter=toggle_fullscreen
keybind = alt+-=decrease_font_size:1

keybind = alt+6=goto_tab:6
keybind = alt+1=goto_tab:1
keybind = alt+9=last_tab
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+8=goto_tab:8
keybind = alt+7=goto_tab:7
keybind = alt+5=goto_tab:5
keybind = alt+2=goto_tab:2
