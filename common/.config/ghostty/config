
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# Font
font-family = "FiraCode Nerd Font Mono"
font-style = Regular
font-size = 12

# Font configuration:
#arrow_right font-family = "FiraCode Nerd Font Mono"
# font-family-italic = "Cartograph CF Italic"
# font-family-bold-italic = "Cartograph CF Italic"
adjust-cell-width = -5%
adjust-cell-height = 20%
adjust-underline-position = 6
adjust-underline-thickness = 40%
adjust-cursor-thickness = 150%

# Cursor:
cursor-color = F8F8F2
cursor-style-blink = false
cursor-text = 000000
shell-integration-features = cursor,ssh-env,ssh-terminfo,sudo

# Splits:
unfocused-split-opacity = 0.4
split-divider-color = A7DFEF

# link-previews = true
# link-url = true
# Cursor styling
# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
selection-clear-on-copy = true
copy-on-select = true
quick-terminal-size = 30%
# Slowdown mouse scrolling
mouse-scroll-multiplier = 1.5
# Keyboard bindings
keybind=clear
keybind = alt+v=new_split:right
keybind = alt+s=new_split:down
keybind = unconsumed:alt+arrow_up=goto_split:up
keybind = unconsumed:alt+arrow_right=goto_split:right
keybind = unconsumed:alt+arrow_left=goto_split:left
keybind = unconsumed:alt+arrow_down=goto_split:down


keybind = alt+n=new_tab
keybind = alt+shift+tab=previous_tab
keybind = alt+tab=next_tab

keybind = alt+1=goto_tab:1
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+2=goto_tab:2

keybind = alt+shift+enter=toggle_fullscreen
keybind = alt+equal=increase_font_size:1
keybind = alt+minus=decrease_font_size:1
keybind = alt+zero=reset_font_size

keybind = alt+shift+b=write_screen_file:paste
keybind = alt+shift+c=write_screen_file:copy
keybind = alt+shift+a=write_scrollback_file:copy

keybind = alt+shift+p=toggle_command_palette
keybind = global:alt+backquote=toggle_quick_terminal
keybind = alt+shift+arrow_up=scroll_to_top
keybind = alt+shift+page_up=scroll_page_up
keybind = alt+shift+page_down=scroll_page_down
keybind = alt+page_up=scroll_page_fractional:-0.5
keybind = alt+page_down=scroll_page_fractional:0.5


keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

keybind = alt+w=close_surface
keybind = alt+shift+w=close_tab


# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
