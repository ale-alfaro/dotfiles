# Wezterm to Ghostty KeybindsA
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard
keybind = super+shift+n=new_tab
keybind = super+w=close_surface
keybind = super+shift+w=close_tab:this
keybind = super+s=new_split:down
keybind = super+n=new_split:right
keybind = super+b=scroll_page_up
keybind = super+f=scroll_page_down
keybind = super+g=scroll_to_top
keybind = super+shift+g=scroll_to_bottom
keybind = super+0=reset_font_size
keybind = super+-=decrease_font_size:1
keybind = super+=increase_font_size:1
keybind = super+p=toggle_command_palette
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9
keybind = semicolon=ignore
keybind = escape=ignore

shell-integration=detect
keybind = global:ctrl+grave_accent=toggle_quick_terminal

command = fish

background-opacity = 0.9

macos-option-as-alt = true

font-family = Fira Code Mono 
