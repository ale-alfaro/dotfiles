
# config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# Font
font-family = "FiraCode Nerd Font"
font-style = Regular
font-size = 12

confirm-close-surface=false

gtk-single-instance = false
gtk-titlebar = false
gtk-wide-tabs = false
confirm-close-surface = false

quit-after-last-window-closed = true
shell-integration = zsh
shell-integration-features = cursor

link-previews = true
link-url = true
# Cursor styling
cursor-style = "block"
cursor-style-blink = true
window-inherit-working-directory=true
selection-clear-on-copy = true
copy-on-select = true
quick-terminal-size = 30%
# Slowdown mouse scrolling
# mouse-scroll-multiplier = 1.0
# Keyboard bindings
# keybind=clear
keybind = alt+v=new_split:right
keybind = alt+d=new_split:down
keybind = ctrl+arrow_up=goto_split:up
keybind = ctrl+arrow_right=goto_split:right
keybind = ctrl+arrow_left=goto_split:left
keybind = ctrl+arrow_down=goto_split:down

keybind = alt+arrow_right=goto_split:next
keybind = alt+arrow_left=goto_split:previous

keybind = alt+shift+n=new_tab
keybind = super+alt+n=new_window

keybind = alt+shift+arrow_left=previous_tab
keybind = alt+shift+arrow_right=next_tab
keybind = alt+6=goto_tab:6
keybind = alt+1=goto_tab:1
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+8=goto_tab:8
keybind = alt+7=goto_tab:7
keybind = alt+5=goto_tab:5
keybind = alt+2=goto_tab:2
keybind = alt+9=last_tab

keybind = alt+equal=increase_font_size:1
keybind = alt++=increase_font_size:1
keybind = alt+enter=toggle_fullscreen
keybind = alt+-=decrease_font_size:1

keybind = alt+shift+p=toggle_command_palette
keybind = global:alt+backquote=toggle_quick_terminal
keybind = alt+shift+arrow_up=scroll_to_up
keybind = alt+shift+arrow_down=scroll_to_bottom
keybind = page_down=scroll_page_down
keybind = page_up=scroll_page_up


keybind = alt+shift+a=select_all
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

keybind = alt+w=close_surface
keybind = alt+shift+w=close_tab
keybind = ctrl+shift+w=close_tab:this
keybind = alt+shift+q=quit





background = #1C1C1C
foreground = #eeeeee
cursor-color = #ffffff

palette = 0=#303030
palette = 8=#b2b2b2

