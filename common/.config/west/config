[grep]
tool = ripgrep
ripgrep.tool-path = /bin/rg
ripgrep.tool-args = '--max-count=10'

[update]
narrow = true
auto-cache = /home/alealfaro/.cache/west

[zephyr]
base-prefer = configfile

[alias]
up = update -k
ls = list -f '{name:20} {path:30} {groups}'
st = status -s
fb = boards --format '{name:30} | {qualifiers:30} | {dir}' -n
tgt = build -p=never -t
tgt.run = tgt run -d
tgt.partitions = tgt partition_manager_report -d
tgt.initlevels = tgt initlevels -d
tgt.resume = tgt all -d
tgt.dash = tgt dashboard -d
gdb = attach -d
pygdb = attach --gdb=arm-zephyr-gdb-py -d
test = twister -vv --inline-logs --clobber-output --no-detailed-test-id
test.sim = test -p native_sim
test.hw = test --device-testing --enable-slow --filter runnable --device-serial
test.renode = simulate -r renode -d
goto = forall -c 'nvim .'
lg = forall -c 'lazygit'
tgt.traceconf = tgt traceconfig -d
tgt.menuconf = tgt menuconfig -d
tgt.sys_menuconf = tgt sysbuild_menuconfig -d

