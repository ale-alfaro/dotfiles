[grep]
tool = ripgrep
ripgrep.tool-path = /bin/rg
ripgrep.tool-args = '--max-count=10 --no-messages'

[update]
narrow = true
auto-cache = /home/alealfaro/.cache/west

[zephyr]
base-prefer = configfile

[alias]
up = update -k
up.shallow = up -o=--depth=1
ls = list -f '{name:20} {path:30} {groups}'
st = status -s --untracked 
tgt = build -p=never -t
conf = tgt menuconfig -d
goto = forall -c 'nvim -c "FzfLua files"'
runto = forall -c 'nvim -c "OverseerRun"'
lg = forall -c 'lazygit'

test = twister -vv --inline-logs --clobber-output --no-detailed-test-id --short-build-paths --ll=DEBUG
test.sim = test -p native_sim --enable-asan --enable-lsan --enable-usan
test.hw = test --device-testing --enable-slow --filter runnable --device-serial=/dev/ttyACM0


