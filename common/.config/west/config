[grep]
tool = ripgrep
ripgrep.tool-path=/bin/rg
ripgrep.tool-args = '--max-count=10'

[update]
narrow = true

[zephyr]
base-prefer = env

[alias]
update = update -o=--depth=1 -n
target = build --pristine=never --target
menuconfig = build --pristine=never --target menuconfig -d
initlevels = build --pristine=never --target initlevels -d
build_resume = build --pristine=never --target all -d
find-board = boards --format "{name:30} | {qualifiers:30} | {dir}" --fuzzy-match
