set unstable := true
set allow-duplicate-recipes := true
set shell := ["zsh", "-uc"]

justfile_home := config_dir() / 'just'

mod agents
mod python
mod gnu-stow
mod JLink
mod openocd
mod arch-linux
mod git
mod direnv
mod zephyr
mod nrfutil
mod ozone

_:
    fd . {{ justfile_home }} --extension=just -d 1 -x \
      just --color=always \
      --list {/.} \
      --justfile {{ justfile_home / 'Justfile' }} \
      --list-heading='{{ "{/.}:" + "\n\n" }}'
