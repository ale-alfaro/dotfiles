set unstable := true
set allow-duplicate-recipes := true
set shell := ["zsh", "-uc"]

justfile_home := config_dir() / 'just'
modules_regex := "python|gnu-stow|JLink|openocd|arch-linux|git|zephyr"

mod agents
mod python
mod gnu-stow
mod JLink
mod openocd
mod arch-linux
mod git
mod zephyr

_:
    fd . {{ justfile_home }} --extension=just -d 1 -x \
      just --color=always \
      --list {/.} \
      --justfile {{ justfile_home / 'justfile' }} \
      --list-heading='{{ "{/.}:" + "\n\n" }}'
