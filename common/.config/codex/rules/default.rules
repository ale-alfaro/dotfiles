prefix_rule(pattern=["/usr/bin/zsh", "-lc", "rg -n \"\" drivers/flash/micron/micron_spi_nand.c drivers/flash/mt29/mt29f4g08.c drivers/flash/cadence/flash_cadence_nand_ll.c"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "rg -n \"SPI_DT_IODEV_DEFINE\" $(rg --files -g '*.h' zephyr include)"], decision="allow")
prefix_rule(pattern=["sort", "-u"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "python - <<'PY'\nimport re\nfrom pathlib import Path\nfiles = ['limb_antlion.conf','limb_dragonfly.conf']\nvals = []\nfor f in files:\n    text = Path(f).read_text()\n    keys = {}\n    for line in text.splitlines():\n        line=line.strip()\n        if not line or line.startswith('#'):\n            continue\n        m=re.match(r'(CONFIG_[A-Z0-9_]+)=(.*)$', line)\n        if not m:\n            continue\n        k,v=m.groups()\n        keys[k]=v\n    vals.append(keys)\ncommon = set(vals[0]).intersection(vals[1])\n# get configs mentioned in cmake files\nimport subprocess, json, os\ncmake_configs=set()\n# search only CMakeLists.txt and *.cmake? and cmake/ maybe. use rg\nimport subprocess, shlex\nrg = subprocess.run(['rg','-o','CONFIG_[A-Z0-9_]+','-S','.'],capture_output=True,text=True)\nfor line in rg.stdout.splitlines():\n    cmake_configs.add(line.strip())\ncommon_in_cmake = sorted(c for c in common if c in cmake_configs)\nprint('common_in_cmake', len(common_in_cmake))\nfor c in common_in_cmake:\n    print(c, vals[0][c], vals[1][c])\nPY"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "python - <<'PY'\nimport re\nfrom pathlib import Path\nconfigs_in_cmake = {\n\"CONFIG_SENSOR\",\n\"CONFIG_MICRON_SPI_NAND\",\n\"CONFIG_TI_TPS62740_REGULATOR\",\n\"CONFIG_DRV2624\",\n\"CONFIG_KTD2026\",\n\"CONFIG_ST25R3916\",\n\"CONFIG_PI42TAS_STRIP\",\n\"CONFIG_MICROPHONE\",\n\"CONFIG_MCUBOOT_SPI_NAND\",\n\"CONFIG_CHARGER\",\n\"CONFIG_SUPPORT_SHIP_MODE\",\n\"CONFIG_BQ25\",\n\"CONFIG_PTX30\",\n\"CONFIG_DHARA_LIBRARY\",\n\"CONFIG_EXAMPLESENSOR\",\n\"CONFIG_MAX30205\",\n\"CONFIG_TMP116SH\",\n\"CONFIG_SH_LSM6DSL\",\n\"CONFIG_MAX30001\",\n\"CONFIG_AS6221\",\n\"CONFIG_SH_BMP5\",\n\"CONFIG_BMA456\",\n\"CONFIG_LP5813\",\n\"CONFIG_SH_BMI323\",\n\"CONFIG_ADG728\",\n\"CONFIG_SH_APDS9960\",\n\"CONFIG_MAX30208\",\n\"CONFIG_TMP119\",\n\"CONFIG_MAX77972\",\n\"CONFIG_SH_AFE1598\",\n\"CONFIG_BMA400\",\n\"CONFIG_AFE4432\",\n\"CONFIG_MAX8614X\",\n\"CONFIG_AFE4432_TRIGGER\",\n\"CONFIG_BMA400_TRIGGER\",\n\"CONFIG_BMA456_TRIGGER\",\n\"CONFIG_SH_BMI323_BUS_SPI\",\n\"CONFIG_BMP5_TRIGGER\",\n\"CONFIG_LSM6DSL_TRIGGER\",\n\"CONFIG_LSM6DSL_SENSORHUB\",\n\"CONFIG_MAX30001_TRIGGER\",\n\"CONFIG_MAX8614X_TRIGGER\",\n}\n\ndef parse_conf(path):\n    text = Path(path).read_text()\n    cfg = {}\n    for line in text.splitlines():\n        line=line.strip()\n        if not line or line.startswith('#'):\n            continue\n        m=re.match(r'(CONFIG_[A-Z0-9_]+)=(.*)$', line)\n        if not m:\n            continue\n        k,v=m.groups()\n        cfg[k]=v\n    return cfg\n\nant = parse_conf('limb_antlion.conf')\ndra = parse_conf('limb_dragonfly.conf')\n\nant_set = set(k for k in ant if k in configs_in_cmake)\ndra_set = set(k for k in dra if k in configs_in_cmake)\nunion = sorted(ant_set | dra_set)\ninter = sorted(ant_set & dra_set)\n\nprint('antlion matched:', len(ant_set))\nprint('dragonfly matched:', len(dra_set))\nprint('union:', len(union))\nfor k in union:\n    a = ant.get(k)\n    d = dra.get(k)\n    print(f\"{k}: antlion={a} dragonfly={d}\")\nprint('\\nintersection:', len(inter))\nfor k in inter:\n    print(f\"{k}: antlion={ant.get(k)} dragonfly={dra.get(k)}\")\nPY"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "rg -n \"spi_nand|spi-nand|spi nand\" -g\"*.c\" -g\"*.h\" ~/zephyrproject/modules/tee/tf-a/trusted-firmware-a"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "rg -n \"mt29f_spi.h|mt29f_defs.h|mt29f.h\" -g\"*.h\" drivers include"], decision="allow")
