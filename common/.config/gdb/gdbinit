


# --- Quality-of-life defaults ---
set confirm off
set pagination off
set print pretty on
# --- set the display radix to hexidecimal ---
set output-radix 16
set print elements 0
set print repeats 0
set print asm-demangle on
set disassemble-next-line on
set breakpoint pending on

# --- Persistent command history (across sessions) ---
set history filename ~/.config/gdb/history
set history save on
set history size 10000
set history remove-duplicates unlimited

# --- Safer auto-loading (project-local .gdbinit/.gdb scripts) ---
# Add trusted directories explicitly instead of disabling protection globally.
# Example: add-auto-load-safe-path ~/src
# (Keep reading below for why.)
add-auto-load-safe-path ~/sibel/eng/fw
add-auto-load-safe-path ~/sibel/eng/fw/playground_workspace
add-auto-load-safe-path ~/sibel/eng/fw/anne_sensors_workspace

