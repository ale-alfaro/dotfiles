


# --- Quality-of-life defaults ---
set confirm off
set pagination off
set print pretty on
# --- set the display radix to hexidecimal ---
set output-radix 16
set print elements 0
set print repeats 0
set print asm-demangle on
set disassemble-next-line on
set breakpoint pending on

# --- Persistent command history (across sessions) ---
set history filename ~/.config/gdb/history
set history save on
set history size 10000
set history remove-duplicates unlimited
set data-directory /opt/zephyr-sdk-custom/arm-zephyr-eabi/share/gdb
# --- Safer auto-loading (project-local .gdbinit/.gdb scripts) ---
# Add trusted directories explicitly instead of disabling protection globally.
# Example: add-auto-load-safe-path ~/src
# (Keep reading below for why.)
add-auto-load-safe-path ~/sibel/eng/fw
add-auto-load-safe-path ~/sibel/eng/fw/anne_sensors_workspace

# --- TUI (text UI) defaults ---
# set debuginfod enabled on
# # fix up our python path first since GDB is likely linked with system (not brewed) python
define z_fault_dump
    printf "\n=== z_arm_fault context ===\n"
    printf "msp=0x%x psp=0x%x exc_return=0x%x\n", $r0, $r1, $r2

    # Fault status registers
    # Entire CFSR
    set $cfsr = *(uint32_t*)0xE000ED28
    # UsageFault Status Register (UFSR)
    set $ufsr = *(uint16_t *)0xE000ED2A
    # BusFault Status Register (BFSR)
    set $bfsr = *(uint8_t *)0xE000ED29
    # MemManage Status Register (MMFSR)
    set $mmfsr = *(uint8_t *)0xE000ED28
    printf "Entire Configurable Fault Register CFSR=0x%08x\n", $cfsr
    printf "UFSR=0x%04x BSFR=0x%02x MMFSR=0x%02x\n", $ufsr, $bfsr, $mmfsr
    set $exc_return = $lr
    set $msp_was_active = $exc_return&(1<<2)

    p/a *(uint32_t[8] *)$msp
    p/a *(uint32_t[8] *)$psp
end

define z_esf_dump
    # Dump stacked registers from esf_copy if available
    if &esf_copy
      printf "ESF: r0=0x%x r1=0x%x r2=0x%x r3=0x%x r12=0x%x lr=0x%x pc=0x%x xpsr=0x%x\n", \
        esf_copy.basic.r0, esf_copy.basic.r1, esf_copy.basic.r2, esf_copy.basic.r3, \
        esf_copy.basic.r12, esf_copy.basic.lr, esf_copy.basic.pc, esf_copy.basic.xpsr
    end

    #Print current thread stack info and name
    if &_kernel
      set $cur = _kernel.cpus[0].current
      printf "current=0x%x\n", $cur
      if $cur
        printf "stack_start=0x%x stack_size=0x%x\n", $cur->stack_info.start, $cur->stack_info.size
        # Uncomment if CONFIG_THREAD_NAME=y
        printf "name=%s\n", $cur->name
      end
    end
  end

source ~/.config/gdb/pygdb/cortex_m.py
