#!/usr/bin/env zsh
set -euxo pipefail
#MISE description = "Spawn a fresh tmux window: west debugserver + pygdb + (telnet RTT | minicom UART)"
#MISE dir = "{{cwd}}"
#MISE interactive = true
#USAGE arg "<dir>" help="build dir"
#USAGE flag "--serial [port]" help="Serial port"


[[ -d "${usage_dir?}" ]] || { echo "${usage_dir} is not a directory"; exit 1 }
elf="${usage_dir}/zephyr/zephyr.elf"
[[ -f "$elf" ]] || { echo "$elf is not found!"; exit 1 }
command -v arm-zephyr-eabi-gdb-py || { echo "arm-zephyr-eabi-gdb-py not in path"; exit 1 }

w=$(sesh window connect dbg -b -c "west rtt -d ${usage_dir} --rtt-client=nc" ) 
tmux split-window -h -t "$w" "until nc -z localhost 2331; do sleep 1; done; arm-zephyr-eabi-gdb-py -ex='target remote :2331' -ex='mon reset' -ex='c' ${usage_dir}/zephyr/zephyr.elf"
[[ -n "${usage_serial}" ]] && tmux split-window -t "$w" "picocom -b 115200  ${usage_serial}" \; select-layout -t "$w" tiled
