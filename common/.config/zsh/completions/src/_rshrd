#compdef rshrd

autoload -U is-at-least

_rshrd() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'(-q --quiet)*-v[]' \
'(-q --quiet)*--verbose[]' \
'(-v --verbose)*-q[]' \
'(-v --verbose)*--quiet[]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_rshrd_commands" \
"*::: :->rshrd" \
&& ret=0
    case $state in
    (rshrd)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rshrd-command-$line[1]:"
        case $line[1] in
            (export)
_arguments "${_arguments_options[@]}" : \
'-n+[Only export the first N pages in the source file]:LIMIT:_default' \
'--limit=[Only export the first N pages in the source file]:LIMIT:_default' \
'--skip=[Skip the first N pages in the source file]:SKIP:_default' \
'*-f+[Output file format(s)]:FORMAT:(parquet csv wav json)' \
'*--format=[Output file format(s)]:FORMAT:(parquet csv wav json)' \
'--invalid-time=[Behavior when a page with an invalid timestamp is encountered]:INVALID_TIME:((error\:"Generate an error"
skip\:"Skip the page"
null\:"Set the timestamp for all samples in the page to \`null\`"))' \
'--compression=[Compression algorithm for output files (Parquet only)]:COMPRESSION:(none lz4 snappy zstd gzip lzo)' \
'--compress=[Compression algorithm for output files (Parquet only)]:COMPRESSION:(none lz4 snappy zstd gzip lzo)' \
'--start-time=[Override the file'\''s start time. Must be an ISO-8601 timestamp]' \
'--device=[Override the file'\''s device type]:DEVICE:((adam\:"ADAM"
aria\:"ARIA"
anne-chest\:"ANNE Chest Adult"
anne-limb\:"ANNE Limb Adult"
anne-chest-neonate\:"ANNE Chest Neonate"
anne-limb-neonate\:"ANNE Limb Neonate"))' \
'--allow-invalid-header[Continue processing the file even if its header is missing or invalid]' \
'--no-fix-rollover[Do not correct returned timestamps when a rollover is detected in the file]' \
'--no-resample[Use the baseline sampling rate for each page type instead of updating the pages'\'' sampling rates based on the page timestamps]' \
'(-q --quiet)*-v[]' \
'(-q --quiet)*--verbose[]' \
'(-v --verbose)*-q[]' \
'(-v --verbose)*--quiet[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':src -- Source SHRD file to export:_default' \
'::dst -- Base directory to write exported files:_files -/' \
'*::filter -- Page types to include or exclude:(info ecg imu accel gyro ppg temp battery heart_rate respiration_rate spo2 pulse_rate perfusion_index cough time_sync barometer mic bioz accel_stats scratch arm_angle haptic activity_index fetal_ecg step_count snore invalid vital event)' \
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : \
'--start-time=[Override the file'\''s start time. Must be an ISO-8601 timestamp]' \
'--device=[Override the file'\''s device type]:DEVICE:((adam\:"ADAM"
aria\:"ARIA"
anne-chest\:"ANNE Chest Adult"
anne-limb\:"ANNE Limb Adult"
anne-chest-neonate\:"ANNE Chest Neonate"
anne-limb-neonate\:"ANNE Limb Neonate"))' \
'--allow-invalid-header[Continue processing the file even if its header is missing or invalid]' \
'--no-fix-rollover[Do not correct returned timestamps when a rollover is detected in the file]' \
'--no-resample[Use the baseline sampling rate for each page type instead of updating the pages'\'' sampling rates based on the page timestamps]' \
'-p[\[deprecated\] no longer used]' \
'--pages[\[deprecated\] no longer used]' \
'-b[Show file-level information only, not information about pages in the file]' \
'--brief[Show file-level information only, not information about pages in the file]' \
'(-q --quiet)*-v[]' \
'(-q --quiet)*--verbose[]' \
'(-v --verbose)*-q[]' \
'(-v --verbose)*--quiet[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':src -- Path to the SHRD file:_default' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'-r+[Maximum number of rows to display per page]:ROWS:_default' \
'--rows=[Maximum number of rows to display per page]:ROWS:_default' \
'-p+[Maximum number of pages to display]:PAGES:_default' \
'--pages=[Maximum number of pages to display]:PAGES:_default' \
'--invalid-time=[Behavior when a page with an invalid timestamp is encountered]:INVALID_TIME:((error\:"Generate an error"
skip\:"Skip the page"
null\:"Set the timestamp for all samples in the page to \`null\`"))' \
'--start-time=[Override the file'\''s start time. Must be an ISO-8601 timestamp]' \
'--device=[Override the file'\''s device type]:DEVICE:((adam\:"ADAM"
aria\:"ARIA"
anne-chest\:"ANNE Chest Adult"
anne-limb\:"ANNE Limb Adult"
anne-chest-neonate\:"ANNE Chest Neonate"
anne-limb-neonate\:"ANNE Limb Neonate"))' \
'--allow-invalid-header[Continue processing the file even if its header is missing or invalid]' \
'--no-fix-rollover[Do not correct returned timestamps when a rollover is detected in the file]' \
'--no-resample[Use the baseline sampling rate for each page type instead of updating the pages'\'' sampling rates based on the page timestamps]' \
'(-q --quiet)*-v[]' \
'(-q --quiet)*--verbose[]' \
'(-v --verbose)*-q[]' \
'(-v --verbose)*--quiet[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':src -- Source SHRD file to display:_default' \
'*::filter -- Page types to include or exclude:(info ecg imu accel gyro ppg temp battery heart_rate respiration_rate spo2 pulse_rate perfusion_index cough time_sync barometer mic bioz accel_stats scratch arm_angle haptic activity_index fetal_ecg step_count snore invalid vital event)' \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
'--start-time=[Override the file'\''s start time. Must be an ISO-8601 timestamp]' \
'--device=[Override the file'\''s device type]:DEVICE:((adam\:"ADAM"
aria\:"ARIA"
anne-chest\:"ANNE Chest Adult"
anne-limb\:"ANNE Limb Adult"
anne-chest-neonate\:"ANNE Chest Neonate"
anne-limb-neonate\:"ANNE Limb Neonate"))' \
'--allow-invalid-header[Continue processing the file even if its header is missing or invalid]' \
'(-q --quiet)*-v[]' \
'(-q --quiet)*--verbose[]' \
'(-v --verbose)*-q[]' \
'(-v --verbose)*--quiet[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'*::src -- A SHRD file or a directory containing SHRD files:_default' \
&& ret=0
;;
(dump)
_arguments "${_arguments_options[@]}" : \
'*-p+[Page range to output]:PAGES:_default' \
'*--pages=[Page range to output]:PAGES:_default' \
'-n+[Maximum number of bytes to show for each page]:LEN:_default' \
'--len=[Maximum number of bytes to show for each page]:LEN:_default' \
'-r[Write unencoded raw bytes to stdout]' \
'--raw[Write unencoded raw bytes to stdout]' \
'--no-header[Do not output the contents of the file header]' \
'(-q --quiet)*-v[]' \
'(-q --quiet)*--verbose[]' \
'(-v --verbose)*-q[]' \
'(-v --verbose)*--quiet[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':src -- Path to the SHRD file:_default' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'(-q --quiet)*-v[]' \
'(-q --quiet)*--verbose[]' \
'(-v --verbose)*-q[]' \
'(-v --verbose)*--quiet[]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- Shell to generate completion scripts for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_rshrd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:rshrd-help-command-$line[1]:"
        case $line[1] in
            (export)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(check)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(dump)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_rshrd_commands] )) ||
_rshrd_commands() {
    local commands; commands=(
'export:Export data from a SHRD file to another file format' \
'info:Display information about a SHRD file' \
'show:Display rows from the pages of a SHRD file' \
'check:Check SHRD files for errors' \
'dump:Output the raw contents of a SHRD file' \
'completions:Generate completion scripts for the specified shell' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rshrd commands' commands "$@"
}
(( $+functions[_rshrd__check_commands] )) ||
_rshrd__check_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd check commands' commands "$@"
}
(( $+functions[_rshrd__completions_commands] )) ||
_rshrd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd completions commands' commands "$@"
}
(( $+functions[_rshrd__dump_commands] )) ||
_rshrd__dump_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd dump commands' commands "$@"
}
(( $+functions[_rshrd__export_commands] )) ||
_rshrd__export_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd export commands' commands "$@"
}
(( $+functions[_rshrd__help_commands] )) ||
_rshrd__help_commands() {
    local commands; commands=(
'export:Export data from a SHRD file to another file format' \
'info:Display information about a SHRD file' \
'show:Display rows from the pages of a SHRD file' \
'check:Check SHRD files for errors' \
'dump:Output the raw contents of a SHRD file' \
'completions:Generate completion scripts for the specified shell' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'rshrd help commands' commands "$@"
}
(( $+functions[_rshrd__help__check_commands] )) ||
_rshrd__help__check_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd help check commands' commands "$@"
}
(( $+functions[_rshrd__help__completions_commands] )) ||
_rshrd__help__completions_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd help completions commands' commands "$@"
}
(( $+functions[_rshrd__help__dump_commands] )) ||
_rshrd__help__dump_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd help dump commands' commands "$@"
}
(( $+functions[_rshrd__help__export_commands] )) ||
_rshrd__help__export_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd help export commands' commands "$@"
}
(( $+functions[_rshrd__help__help_commands] )) ||
_rshrd__help__help_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd help help commands' commands "$@"
}
(( $+functions[_rshrd__help__info_commands] )) ||
_rshrd__help__info_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd help info commands' commands "$@"
}
(( $+functions[_rshrd__help__show_commands] )) ||
_rshrd__help__show_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd help show commands' commands "$@"
}
(( $+functions[_rshrd__info_commands] )) ||
_rshrd__info_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd info commands' commands "$@"
}
(( $+functions[_rshrd__show_commands] )) ||
_rshrd__show_commands() {
    local commands; commands=()
    _describe -t commands 'rshrd show commands' commands "$@"
}

if [ "$funcstack[1]" = "_rshrd" ]; then
    _rshrd "$@"
else
    compdef _rshrd rshrd
fi
