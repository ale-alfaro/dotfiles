#!/usr/bin/env zsh


if [[ $# -eq 0 ]]; then
  echo "usage: fwest <dir> [board]" >&2
  return 1 2>/dev/null || exit 1
fi

local dir="${1:-$PWD}"
local usage_board="${2:-}"
fd -tf -e yaml '(testcase|sample)\.yaml' "${dir?}" \
        -x yq '.common as $c 
                | .tests | select(.) | to_entries | .[] 
                | "{//} {} " + .key + " " + ([.value.integration_platforms // .value.platform_allow // $c.integration_platforms // $c.platform_allow // "aria/nrf5340/cpuapp"] 
                | flatten | .[0] | split(" ") | .[0])' {} \
        | fzf \
              --prompt=' App> ' \
              --header ' enter: west build <app>/<case>  [board]' \
              --with-nth='{1}/{3} [{4}]' --accept-nth='{1} {3} {4}' --preview='yq e {2}' \
        | read dir test board

[[ -z "$dir" || -z "$test" || -z "$board" ]] && {
  echo "fwest: arguments missing" >&2
  return 1
}
west build -d build/$test $([[ -d build/$test ]] || echo "-p -b ${usage_board:-$board} $dir -T $test")
