#!/usr/bin/env zsh
set -euo pipefail

(($# < 2)) && {
  printf -- 'usage: %s <project:CWP|FWP> <type:Task|Story|Bug>\n' "${0}"
  return 1
} >&2

prompt() {
  local question="$1" answer
  printf '%s [y/N] ' "$question" >&2
  read -r answer
  [[ "$answer" =~ ^[Yy]$ ]]
}

work_item_json=$(acli jira workitem create --editor --project "${1}" --type "${2}" --json)

key=$(printf '%s' "$work_item_json" | jq -r '.key')
branch_name=$(printf '%s' "$work_item_json" | jq -r '
  "\(.key)/\(.fields.summary | ascii_downcase | gsub("[^a-z0-9 -]"; "") | gsub(" +"; "-"))"
')

printf 'Created: %s\nBranch:  %s\n' "$key" "$branch_name"

prompt "View ticket in browser?" && acli jira workitem view "$key" -w

if prompt "Create git branch '$branch_name'?"; then
  repo=$(
    fd -H -d 5 -t d -g '.git' ~ 2>/dev/null |
      sed 's|/.git/?$||' |
      fzf --prompt=' Repo> ' \
          --preview-window 'right:50%' \
          --preview 'git -C {} log --oneline --color=always -10 2>/dev/null'
  )
  git -C "$repo" checkout -b "$branch_name"
  printf 'Branch created in %s\n' "$repo"
fi
