#!/usr/bin/env zsh

compress() {
  tar -czf "${1%/}.tar.gz" "${1%/}"
}

alias decompress="tar -xzf"
_open() {
  xdg-open "$@" >/dev/null 2>&1 &
}
alias open='_open'
#######################################################
# CLI Aliases
#######################################################
# Alias For bat
alias lt='eza --tree --level=3 --long --icons --git'
alias ls="eza  -1 -l -a --header --no-permissions --group-directories-first --sort=time -r"
alias lg='lazygit'
alias lgp='lazygit -p'
alias jlink-gdbserver='JLinkGDBServer  -if SWD -speed 4000 -port 2331 -silent -singlerun'
alias mx='mise x'
alias mr='mise run'
alias mt='mise tasks'
alias mtl='mt --local'
alias mta='mt --all'
#include jq modules
alias jq='jq -L~/.config/jq'
alias jira='acli jira'
