{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "CodeCompanion",
  "description": "A Neovim plugin. Integrate CodeCompanion and Neovim",
  "properties": {
    "codecomapnion.autosave": {
      "default": true,
      "markdownDescription": "Enable the Quick Fix.",
      "type": "boolean"
    },
    "codecomapnion.resumeChat": {
      "default": true,
      "markdownDescription": "Enable the Quick Fix.",
      "type": "boolean"
    },
    "codecomapnion.extensions": {
      "default": [],
      "extension": {
        "type": "string"
      },
      "scope": "resource",
      "type": "array"
    },
  },
  "type": "object"
}
