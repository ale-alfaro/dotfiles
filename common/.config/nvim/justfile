# Neovim Configuration Commands
# Run with: just <recipe-name>

# Check configuration for build errors
check-config:
    nvim --headless -c '5sleep' -c ':q' .

# Run Neovim health check
check-health:
    nvim --headless -c "checkhealth" -c '5sleep'  -c "qall"

# Format all Lua files with stylua
format:
    stylua .

# Run both configuration check and health check
check-all: check-config check-health

# Open Neovim with this configuration

# Show available recipes
default:
    just --list
