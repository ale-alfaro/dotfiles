set shell := ['zsh', '-uc']
set unstable := true

root := source_dir()
fake_workspace := root / 'scratch/fake_workspace'
fake_state := fake_workspace / '.nvim-state'
fake_tmp := fake_workspace / '.nvim-tmp'
nvim := require('nvim')
stylua := require('stylua')

# Show available recipes
@_:
    just --list

# --- CHECKS ---

[doc('Simple headless command for quick LSP/settings checks')]
check:
    {{ nvim }} --headless -c ":lua vim.print('hello')" -c "qall"

[doc('Run Neovim health check')]
check-health:
    {{ nvim }} --headless -c "checkhealth" -c '5sleep' -c "qall"

[doc('Run both configuration check and health check')]
check-all: check check-health

[doc('Verify local LSP configs load and completion works in fake workspace')]
[working-directory('scratch/fake_workspace')]
check-local-lsp:
    {{ nvim }} --headless -c ':e index.rst' -c ':LspLocalStart esbonio' -c '5sleep' -c 'qall'

# --- FORMATTING ---

[doc('Format all Lua files with stylua')]
format:
    {{ stylua }} .
