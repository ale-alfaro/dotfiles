{
  "zephyr-starter": {
    "prefix": "<z",
    "body": [
      "#include <zephyr/kernel.h>",
      "#include <zephyr/sys/util.h>",
      "${1:#include <zephyr/sys/check.h>}",
      "$0"
    ],
    "description": "starter for a Zephyr project"
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:rc}) {",
      "\tcase ${3:-EIO}:",
      "\t\t$0",
      "\t\tbreak;",
      "${2:\tcase 0:\n\t\tbreak;}",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ],
    "description": "'switch' snippet"
  }
}
