{
  "neodev": {
    "library": {
      "enabled": true,
      "plugins": [
        "nvim-lspconfig",
        "lsp"
      ]
    }
  },
  "neoconf": {
    "plugins": {
      "lua_ls": {
        "enabled": true
      },
      "jsonls": {
        "enabled": true
      },
    }
  },
  "lspconfig": {
    "lua_ls": {
      "Lua.completion.callSnippet": "Replace"
    },
    "pyright": {
      "python.analysis.typeCheckingMode": "basic",
      "python.analysis.diagnosticMode": "openFilesOnly"
    },
    "vectorcode_server": false
  }
}
