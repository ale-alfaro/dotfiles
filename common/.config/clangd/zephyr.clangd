CompileFlags:
  Add: [
      -DKERNEL,
      -D_FORTIFY_SOURCE=2,
      -D__PROGRAM_START,
      -D__ZEPHYR_SUPERVISOR__,
      -D__ZEPHYR__=1,

      # Reasonable warnings:
      -Wall,
      -Wextra,
      -Wformat,
      -Wformat-security,
      -Wmissing-variable-declarations,
      -Wmissing-declarations,
      -Wmissing-prototypes,
      -Wno-format-zero-length,
      -Wno-main,
      -Wno-address-of-packed-member,
      -Wno-pointer-sign,
      -Wno-sign-compare,
      -Wno-unused-parameter,
      -Wno-unused-variable,
      -Wno-sizeof-array-decay,
      -Wunused-function,
      -Wpointer-arith,
      -Werror=implicit-int,

      # All errors:
      -ferror-limit=0,
    ]
  Remove: [-fno-printf-return-value, -mfp16-format=*, -fno-reorder-functions]
