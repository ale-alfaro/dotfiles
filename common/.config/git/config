[user]
	name = Ale Alfaro
	email = ale16alfaro@gmail.com
[credential "https://github.com"]
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = !gh auth git-credential

[alias]
  st = status -s
  lol = log --oneline --graph --all

[extensions]
  relativeWorktrees = true

[branch]
  sort = -committerdate
[column]
  ui = always
[core]
  pager = bat
  editor = nvim
[fetch]
	prune = true
[pull]
  rebase = true
  autoStash = true
[push]
  default = simple
	autoSetupRemote = true
[diff]
	tool = nvimdiff
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
  enabled = true
  autoUpdate = true
[init]
	defaultBranch = main
[merge]
  conflictStyle = zdiff3
	tool = nvimdiff
[web]
  browser = zen-browser
[worktree]
  useRelativePaths = true
  guessRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pager]
	diff = diffnav
