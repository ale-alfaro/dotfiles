[credential "https://github.com"]
	helper = 
	helper = !mise exec gh -- gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !mise exec gh -- gh auth git-credential

[alias]
  st = status -s
  lol = log --oneline --graph --all
  dft = -c diff.external=difft diff
  # `git log` with patches shown with difftastic.
  dl = -c diff.external=difft log -p --ext-diff
  # Show the most recent commit with difftastic.
  ds = -c diff.external=difft show --ext-diff

[extensions]
  relativeWorktrees = true

[branch]
  sort = -committerdate
[column]
  ui = always
[core]
  editor = nvim
	autocrlf = input
[fetch]
	prune = true
[pull]
  rebase = true
  autoStash = true
[push]
  default = simple
	autoSetupRemote = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
  enabled = true
  autoUpdate = true
[init]
	defaultBranch = main
[merge]
	conflictStyle = zdiff3
	tool = codediff
[web]
  browser = ~/.local/bin/zen
[worktree]
  useRelativePaths = true
  guessRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[interactive]
	diffFilter = difft
[hook "hk-pre-commit"]
    command = test "${HK:-1}" = "0" || mise exec -- hk run pre-commit --from-hook "$@"
    event = pre-commit
[hook "hk-pre-push"]
    command = test "${HK:-1}" = "0" || mise exec -- hk run pre-push --from-hook "$@"
    event = pre-push
[hook "hk-commit-msg"]
    command = test "${HK:-1}" = "0" || mise exec -- hk run commit-msg --from-hook "$@"

[difftool "difftastic"]
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[difftool]
    # Run the difftool immediately, don't ask 'are you sure' each time.
    prompt = false

[pager]
    # Use a pager if the difftool output is larger than one screenful,
    # consistent with the behaviour of `git diff`.
    difftool = true

[diff]
    # Set difftastic as the default difftool, so we don't need to specify
    # `-t difftastic` every time.
    tool = difftastic

