[user]
	name = Ale Alfaro
	email = alejandro.alfaro@sibelhealth.com
[pull]
	rebase = false
[branch]
	sort = committerdate
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
[difftool]
prompt = true

[diff]
tool = nvimdiff

[difftool "nvimdiff"]
cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
