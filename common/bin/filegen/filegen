class FileType(StrEnum):
    CSource = "c"
    CHeader = "h"


def ensure_snake_case(name: str) -> str:
    # Insert an underscore before any uppercase letter that follows a lowercase letter or digit
    s1 = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", name)
    # Insert an underscore before any uppercase letter that follows another uppercase letter
    # but is at the end of an acronym (e.g., HTMLParser becomes html_parser)
    s2 = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1_\2", s1)
    # Convert the entire string to lowercase
    return s2.lower()


@attrs.define
class FileGen:
    filename: str
    template_file: Path
    filetype: FileType
    dir_path: Path = attrs.field(factory=Path.cwd)
    root_dir: Path = attrs.field(factory=Path.cwd)

    def path_to_header_guard(self) -> str:
        if not self.dir_path.is_relative_to(self.root_dir):
            raise FileNotFoundError
        rel_dir = str(self.dir_path.relative_to(self.root_dir))
        guard_parts = [rel_dir, ensure_snake_case(self.filename)]
        header_guard = "_".join(part for part in guard_parts if part)
        return f"__{header_guard.upper()}_H__"

    def write_file(self, *, contents: str, force: bool) -> Path:
        self.dir_path.mkdir(parents=True, exist_ok=True)
        out_fp = self.dir_path / f"{ensure_snake_case(self.filename)}.{self.filetype}"
        existed = out_fp.exists()
        if existed and not force and not confirm_overwrite(out_fp):
            msg = f"{out_fp} already exists; overwrite canceled"
            raise FileExistsError(msg)
        out_fp.write_text(contents, encoding="utf-8")
        action = "Overwrote" if existed else "Created"
        console.print(f"[green]{action}[/green] {out_fp}")
        return out_fp


app = cyclopts.App()

TEMPLATE_DIR_ENV = "FILEGEN_TEMPLATES"


def _iter_group_values(argument_collection: object) -> Iterable[object]:
    if hasattr(argument_collection, "values"):
        yield from (getattr(arg, "value", arg) for arg in argument_collection.values())
        return
    try:
        iterator = iter(argument_collection)  # type: ignore[arg-type]
    except TypeError:
        return
    for arg in iterator:
        yield getattr(arg, "value", arg)


file_type_group = Group(
    "File Types (choose one or more)",
    default_parameter=cyclopts.Parameter(show_default=False, negative=""),
)


def confirm_overwrite(path: Path) -> bool:
    while True:
        reply = input(f"{path} exists. Overwrite? [y/N]: ").strip().lower()
        if not reply or reply in {"n", "no"}:
            return False
        if reply in {"y", "yes"}:
            return True
        error_console.print("Please answer 'y' or 'n'.")


def find_template_dir_in_repo_root(start: Path | None = None) -> Path | None:
    repo_root_dir = start or Path.cwd()
    try:
        proc = subprocess.run(
            shlex.split("git rev-parse --show-toplevel"),
            capture_output=True,
            check=True,
            shell=False,
        )
        if (stdout_res := proc.stdout) and Path(stdout_res.rstrip()).is_dir():
            repo_root_dir = Path(stdout_res.rstrip(), "template")
    except subprocess.CalledProcessError:
        console.print("Failed to get git repo root. Are you inside a repository?")
        current = repo_root_dir
        for parent in [current, *current.parents]:
            if (parent / ".git").exists():
                repo_root_dir = parent
    return (
        Path(repo_root_dir / "templates")
        if Path(repo_root_dir / "templates").is_dir()
        else None
    )


def parse_template_from_file(path: Path) -> tuple[FileType, string.Template]:
    raw = path.read_text(encoding="utf-8")
    lines = raw.splitlines()
    if not lines or lines[0].strip() != "---":
        raise ValueError

    metadata: dict[str, str] = {}
    content_start = -1
    for idx, raw in enumerate(lines[1:]):
        line = raw.strip()
        if line == "---":
            # Found end
            content_start = idx + 1
            break
        if line.startswith("#") and ":" in line:
            key, value = line.split(":", 1)
            metadata[key.strip().lower()] = value.strip()
    if not metadata or not (ft := metadata.get("filetype")):
        raise ValueError
    body = "\n".join(lines[content_start:]) if content_start else raw
    return ft, string.Template(body)


@attrs.define
class TemplateMetadata:
    filetype: str


def load_templates_from_dir_generator(
    template_dir: Path,
) -> Generator[tuple[str, string.Template]]:
    for path in sorted(template_dir.iterdir()):
        if not path.is_file():
            continue
        filetype, template_content = parse_template_from_file(path)
        ext = path.suffix.lstrip(".")
        expected = f"{filetype}tf"
        if ext != expected:
            continue
        yield (filetype, template_content)


def validate_types(instance: "FileGen", attribute, value: list[str]) -> None:
    unknown = [t for t in value if t not in instance.templates]
    if unknown:
        known = ", ".join(sorted(instance.templates)) or "none"
        msg = f"Unknown type(s): {', '.join(unknown)}. Available: {known}"
        error_console.print(msg)
        raise cyclopts.ValidationError(
            msg,
        )


def _template_dir_from_env(self) -> Path | None:
    env_dir = DOTENV_VALUES.get(TEMPLATE_DIR_ENV)
    if env_dir:
        return Path(env_dir).expanduser().resolve()

    cwd_templates = Path.cwd() / "templates"
    if cwd_templates.exists():
        return cwd_templates.resolve()

        return find_template_dir_in_repo_root(self.dst)
    return None


def _template_dir_to_templates_converter(
    value: Path | None,
) -> dict[FileType, string.Template]:
    tdir = value or _template_dir_from_env()
    if not tdir.is_dir():
        msg = f"{tdir} is not a directory"
        error_console.print(msg)
        raise cyclopts.ValidationError(msg)
    return dict(
        load_templates_from_dir_generator(tdir)
        for tdir in filter(
            p for p in tdir.iterdir() if p.is_file() and p.suffix.endswith("tf")
        )
    )


@cyclopts.Parameter(name="*")
@attrs.define
class FileGen:
    name: Annotated[
        str,
        cyclopts.Parameter("out", required=True, help="Name of the output file"),
    ] = attrs.field(converter=ensure_snake_case)
    dst: Annotated[Path, cyclopts.Parameter(help="Destination of output file")] = (
        attrs.field()
    )

    @dst.default
    def _dst_default(self) -> Path:
        return Path.cwd()

    @dst.validator
    def _dst_path_validator(self, _attr: attrs.Attribute, value: Path) -> None:
        if value.exists() and not value.is_dir():
            msg = f"{value} exists and is not a directory"
            error_console.print(msg)
            raise cyclopts.ValidationError(msg)

    proj_root: Annotated[
        Path,
        cyclopts.Parameter(
            ["-r", "--root"],
            help="Directory to write files into",
        ),
    ] = attrs.field()

    @proj_root.default
    def _proj_root_default(self) -> Path:
        return Path.cwd().parent

    template_dir: Annotated[
        Path,
        cyclopts.Parameter(help="User provided template directory"),
    ] = attrs.field()

    @template_dir.default
    def _template_dir_default(self) -> Path:
        return Path(Path.cwd(), "templates")

    @cached_property
    def templates(self) -> dict[str, Path] | None:
        tdir = self.template_dir or _template_dir_from_env()
        if not tdir.is_dir():
            msg = f"{tdir} is not a directory"
            error_console.print(msg)
            raise cyclopts.ValidationError(msg)
        return dict(
            load_templates_from_dir_generator(tdir)
            for tdir in filter(
                p for p in tdir.iterdir() if p.is_file() and p.suffix.endswith("tf")
            )
        )

    def resolve_filetypes_with_requested_ft(
        self,
        requested_ft: list[str] | None = None,
    ) -> list[TemplateMetadata]:
        all_tp_ft = set(self.templates.keys())
        if not requested_ft:
            return all_tp_ft

        user_ft = set(requested_ft)
        resolved_ft = all_tp_ft | user_ft
        if not resolved_ft:
            known = ", ".join(all_tp_ft) or "none"
            msg = f"Unknown type(s): {', '.join(user_ft)}. Available: {known}"
            error_console.print(msg)
            raise cyclopts.ValidationError(msg)
        if len(resolved_ft) != len(user_ft):
            console.print(
                f"WARNING: Unknonw template type provided: {user_ft - resolved_ft}",
            )
        return resolved_ft

    def render_templates(self, filetype: FileType, *, force: bool = False) -> None:
        if filetype not in self.templates:
            raise ValueError
        template_body: string.Template = self.templates[filetype]
        file_dst: str = Path(self.dst, f"{self.filename}.{filetype}")
        template_interpolations = {
            "file_name": self.name,
            "year": date.today().year,
        }
        if filetype == FileType.CHeader:
            template_interpolations["header_guard"] = file_dst.path_to_header_guard()
        contents = template_body.substitute(template_interpolations)
        file_dst.write_file(contents=contents, force=force)


@app.command(name="gen")
def generate(
    fgen: FileGen,
    *,
    types: Annotated[
        list[str] | None,
        cyclopts.Parameter(
            ["-t", "--type"],
            group=file_type_group,
            help="Generate files matching TYPE (repeatable, supports TYPE=all)",
        ),
    ] = None,
    force: Annotated[
        bool,
        cyclopts.Parameter(
            ["-f", "--force"],
            negative="",
            help="Overwrite existing files without prompting",
        ),
    ] = False,
) -> None:
    """
    Generate C header/source files from templates.

    Defaults to generating all discovered file types when no type flags are provided.
    File-type flags can be repeated, e.g. "-t c -t h" or "-t all".
    Use the `shell` command for an interactive session when generating many files.
    Template directory resolution order: --template-dir, $FILEGEN_TEMPLATES,
    then <repo-root>/templates (repo-root detected by .git).
    Templates must include frontmatter with a "filetype" entry.
    Template frontmatter example:
        ---
        filetype: c
        ---
    Required template fields:
        Header (.htf): ${file_name}, ${header_guard}, ${year}
        Source (.ctf): ${file_name}, ${year}
    Other file types are discoverable, but generation is currently limited to c/h.
    """
    # extra_templates=type_add,
    resolved_types = fgen.resolve_templates_with_requested_ft(
        requested_types=types,
    )
    console.print(
        f"[bold]Generating[/bold] [cyan]{fgen.name}[/cyan] in {fgen.dir_path}",
    )
    console.print(
        f"[dim]Templates:[/dim] {fgen.template_dir}",
    )
    console.print(
        f"[dim]Types:[/dim] {', '.join(resolved_types)}",
    )
    for ft in resolved_types:
        fgen.render_templates(filename=fgen.name, filetype=ft)


@app.command(name="ft")
def filetype(
    *,
    template_dir: Annotated[
        Path | None,
        cyclopts.Parameter(
            ["--template-dir"],
            help=(
                "Template directory to use (defaults to $FILEGEN_TEMPLATES "
                "or <repo>/templates)"
            ),
        ),
    ] = None,
) -> None:
    """Manage template filetypes. Subcommands: list."""
    template_dir = template_dir or Path.cwd() / "templates"
    if template_dir and not template_dir.is_dir():
        msg = (
            "Template directory not found. Provide --template-dir, set "
            f"{TEMPLATE_DIR_ENV}, or place templates in <repo>/templates."
        )
        raise NotADirectoryError(
            msg,
        )
    templates = [template_dir.absolute(), *_template_dir_from_env()]
    if not templates:
        console.print("No templates discovered.")
        raise ValueError
    console.print("Discovered templates:")
    for key in sorted(templates):
        console.print(f"  {key}\t{templates[key]}")


