/**** USER FUNCTIONS ****/

void SetBreakpointAtResetHandler(void) {
    Break.SetOnSrc("z_arm_reset");
}

void BreakpointAtMain(void) {
    Break.SetOnSrc("main");
}
/*** Debug Start Flow
    Phase 1: ConnectA connection to the target is established via J-Link/J-Trace.
    Phase 2: BreakpointsPending (data) breakpoints that were set in offline mode are
    applied.
    Phase 3: ResetA hardware reset of the target is performed.
    Phase 4: DownloadThe debuggee is downloaded to target memory.
    Phase 5: Finish the initial program operation is performed
*/
void DebugStart (void) {
    Exec.Connect();
    Exec.Reset();
    Exec.Download("$(ProjectDir)/app/build_pro_micro_rp2350_corne_right/zephyr/zmk.elf");
}

void SetupTargetInitRegisters(void) {

    unsigned int SP;
    unsigned int PC;
    //
    // The vector table for the RP2350 in this project is located at
    // a fixed address. Elf.GetBaseAddr() may not return the correct
    // start of the image where the vector table resides.
    //
    //unsigned int RpicoVTORAddrFixed = 0x10000200;
    unsigned int VectorTableAddr;
    VectorTableAddr = 0x10000200;

    //VectorTableAddr = Elf.GetBaseAddr();
    //Util.LogHex("VectorTableAddr", VectorTableAddr);
    //if (VectorTableAddr != 0x10000200) {
    //  Util.Error("Project script error: VectorTableAddr is not at expected address", 1);
    //}

    // Set up initial stack pointer
    SP = Target.ReadU32(VectorTableAddr);
    Util.LogHex("Setting stack pointer", SP);
    Target.SetReg("SP", SP);

    // Set up entry point PC
    PC = Elf.GetEntryPointPC();

    if (PC != 0xFFFFFFFF) {
        Util.LogHex("Program counter is valid, setting PC to ELF file entry point PC:", PC);
        Target.SetReg("PC", PC);
    } else if (VectorTableAddr != 0xFFFFFFFF) {
        PC = Target.ReadU32(VectorTableAddr + 4);
        Util.LogHex("Program counter  is not valid, setting PC to Vector Table address PC", PC);
        Target.SetReg("PC", PC);
    } else {
        Util.Error("Project file error: failed to set entry point PC", 1);
    }
}


/*********************************************************************
*
*       OnProjectLoad
*
* Function description
*   Project load routine. Required.
*
**********************************************************************
*/
void OnProjectLoad (void) {
  //
  // Dialog-generated settings
  //
  Project.AddPathSubstitute ("/home/alealfaro/GeekieStuff/dyi-keyboard/fw/zmk", "$(ProjectDir)");
  Project.SetDevice ("RP2350_M33_0");
  Project.SetHostIF ("USB", "52001095");
  Project.SetTargetIF ("SWD");
  Project.SetTIFSpeed ("4 MHz");
  //
  // User settings
  //
  Project.SetRTT(1);
  File.Open ("$(ProjectDir)/app/build_pro_micro_rp2350_corne_right/zephyr/zmk.elf");
  Project.AddSvdFile ("$(ProjectDir)/utils/JLink/RP2350.svd");
  Project.SetOSPlugin ("ZephyrPlugin");

}

